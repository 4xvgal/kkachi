# kkachi server configuration. Copy to `.env` (Bun auto-loads it; docker compose reads it).
# Every value below is optional except VAPID keys.

# --- HTTP / domain -----------------------------------------------------------
PORT=8787
# Public origin used to canonicalize NIP-98 `u` behind a proxy/domain.
# e.g. https://push.example.com . Leave empty to use the request URL.
PUBLIC_URL=
# Browser CORS origins allowed to call the API. Comma-separated; use * for any.
# e.g. http://localhost:5173,https://app.example.com
CORS_ORIGIN=

# --- Relays ------------------------------------------------------------------
# Comma-separated. Used as the default when a subscriber sends no `relays`.
RELAYS=ws://localhost:4444/relay
# Optional: relay the PWA demo publishes to (defaults to the first RELAYS entry).
PWA_RELAY=
# Per-relay query timeout (ms).
RELAY_TIMEOUT_MS=10000

# --- Persistence -------------------------------------------------------------
# empty = in-memory, sqlite:./kkachi.db = SQLite, postgres://... = Postgres
DATABASE_URL=
# Postgres (docker compose) credentials.
POSTGRES_USER=kkachi
POSTGRES_PASSWORD=kkachi
POSTGRES_DB=kkachi
# Host port for docker compose (container listens on PORT).
HOST_PORT=8787

# --- Web Push (VAPID) --------------------------------------------------------
# Required. Generate: bun -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# --- Polling -----------------------------------------------------------------
# Base interval and jitter.
POLL_BASE_MS=60000
POLL_SPREAD_MS=15000
# Lookback window per poll (seconds). NIP-59/17 randomize created_at up to 2
# days into the past, so keep this >= 172800. Default 2d + 1h margin.
POLL_LOOKBACK_SEC=176400
# Per-page relay limit and max pages (window pagination).
POLL_LIMIT=500
POLL_MAX_PAGES=10

# --- Event handling ----------------------------------------------------------
MAX_P_TAGS=10
AUTH_MAX_SKEW_SEC=60

# --- Rate limits -------------------------------------------------------------
# Outbound push, per target.
PUSH_RATE_BURST=5
PUSH_RATE_REFILL_PER_MIN=5
# Inbound API, per signer.
API_RATE_BURST=10
API_RATE_REFILL_PER_MIN=10
# Hard cap on stored subscriptions.
MAX_SUBS=10000
